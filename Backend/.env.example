DB_NAME=hortyfru
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
SECRET_KEY=generar_una_clave_aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OSRM propio: el celular consulta Django; este puerto queda en la computadora.
OSRM_URL=http://127.0.0.1:5000
OSRM_TIEMPO_LIMITE_S=8
OSRM_RADIO_ACCESO_M=150
OSRM_MAX_PUNTOS=100
# Para el trabajador en Docker se configura rutas como servidor interno.
OSRM_SERVIDORES_INTERNOS=
OPTIMIZACION_HABILITADA=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
COLA_OPTIMIZACION=hortyfru_optimizacion
# Seguimiento del administrador local: avisos y accesos efimeros separados de Celery.
SUPERVISION_HABILITADA=True
SUPERVISION_REDIS_URL=redis://127.0.0.1:6379/1
SUPERVISION_ACCESOS_REDIS_URL=redis://127.0.0.1:6379/2
SUPERVISION_ORIGENES=http://localhost:3000,http://127.0.0.1:3000
# Respaldos manuales privados en el servidor (opcional: por defecto .local/respaldos).
# RESPALDOS_DIRECTORIO=C:/Respaldos/HortyFru
# RESPALDOS_PG_BIN=C:/Program Files/PostgreSQL/18/bin
RESPALDOS_TIEMPO_MAXIMO_S=900
