{
  "name": "hortyfru-movil",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "comprobar": "tsc --noEmit",
    "comprobar:logica": "tsc --project tsconfig.logica.json",
    "compilar:android": "node herramientas/compilar_android.mjs",
    "test": "node --test pruebas/*_movil.mjs",
    "exportar": "expo export --platform android --output-dir dist/android",
    "exportar:web": "expo export --platform web --output-dir dist/web"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.1",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-location": "58.0.20",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
